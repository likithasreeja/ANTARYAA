# ===========================================
# ANTARYA – API Keys & Configuration
# ===========================================
# Copy this file to .env and fill in your keys

# Google Gemini API (free tier)
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Bhashini API (Indian govt speech/translation)
# Get from: https://bhashini.gov.in/ulca/user/login → My Profile
BHASHINI_USER_ID=
BHASHINI_API_KEY=

# JWT Secret (required in production)
JWT_SECRET=change-me-to-a-long-random-string

# MongoDB Atlas connection string (required in production / Render)
# Atlas → Cluster0 → Connect → Drivers → Node.js (5.5 or later / newest listed)
# Replace <password> and add the database name: ...mongodb.net/antarya?retryWrites=true&w=majority
# Never commit the real URI. MONGO_URI is accepted as a legacy alias.
MONGODB_URI=
# MONGO_URI=
# Optional. Used only if the URI has no database name in the path.
# MONGODB_DB=antarya

# Deployed frontend origin(s), comma-separated. https://*.vercel.app is also allowed.
FRONTEND_ORIGIN=https://antarya-one.vercel.app

# Optional Python ML service URL (Inventory Planner / demand). Leave empty if not deployed.
# FASTAPI_URL=https://your-ml-service.onrender.com

# Server Port
PORT=5001

# ===========================================
# Merchant Payment Provider (Razorpay / UPI)
# ===========================================
# 1. Sign up / log in to https://dashboard.razorpay.com/
# 2. Go to Account & Settings → API Keys → Generate Key (Test Mode first)
# 3. For Webhooks: Settings → Webhooks → Add Webhook
#    URL: https://your-domain.vercel.app/api/payments/webhook
#    Events: payment.captured, payment.failed, order.paid
#    Secret: set a strong secret string and paste below
#    For local testing the URL must be public, e.g. run `ngrok http 5001` and use
#    https://<id>.ngrok-free.app/api/payments/webhook
#    Without a webhook, payments are still verified (checkout signature + Razorpay API fetch).
# rzp_test_... keys = no real money moves. rzp_live_... keys (after KYC) = real UPI payments.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Antarya monthly subscription the shopkeeper pays (₹ per month)
SUBSCRIPTION_MONTHLY_PRICE=299
SUBSCRIPTION_PLAN_NAME=Antarya Monthly Plan

# Platform UPI account that RECEIVES the monthly subscription (the Antarya developer,
# not the shop). Shown to shopkeepers as a "Pay via UPI QR" option. QR payments stay
# "pending" until the platform admin verifies them in /admin against the bank statement.
PLATFORM_UPI_VPA=
PLATFORM_UPI_NAME=Antarya

# Platform admin dashboard (/admin). Leave empty to disable admin login.
# Use a strong password (min 8 characters); never commit real values.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional: separate signing key for admin sessions (defaults to one derived from
# JWT_SECRET + ADMIN_PASSWORD, so changing the password logs out all admin sessions).
ADMIN_JWT_SECRET=

# Only for local demos: shows the "Simulate webhook" button for customer QR payments.
# Ignored automatically with live keys. Leave false in any shared/deployed environment.
ENABLE_PAYMENT_TEST_EVENTS=false

# Merchant UPI Details for Dynamic Counter QRs
UPI_MERCHANT_VPA=payments@antarya
UPI_MERCHANT_NAME=Antarya Kirana
