# Google Analytics 4 Measurement ID
# Create a GA4 property → Data Streams → Web Stream → Measurement ID (G-XXXXXXXXXX)
# Leave blank or set your real Measurement ID:
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel project token (browser SDK)
# Mixpanel → your project → Settings → Project Settings → Project Token
# Never commit the real token. Vite inlines this at build time.
VITE_MIXPANEL_TOKEN=YOUR_MIXPANEL_TOKEN
# Optional. Required only if the Mixpanel project uses EU or India data residency.
# EU: https://api-eu.mixpanel.com
# India: https://api-in.mixpanel.com
# VITE_MIXPANEL_API_HOST=https://api-in.mixpanel.com

# API Backend URL
# Local: Vite proxy forwards /api to port 5001, so this can stay commented.
# Vercel production: set this to your Render API, including /api
# Example: https://antarya-api.onrender.com/api
# VITE_API_URL=https://YOUR-RENDER-SERVICE.onrender.com/api
